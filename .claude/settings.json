{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/py-check.sh\"",
            "timeout": 120,
            "statusMessage": "Checking practices (ruff + import contracts)"
          }
        ]
      }
    ]
  }
}
